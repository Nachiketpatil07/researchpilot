# Copy this file to .env and fill in your own keys. Never commit .env.

# Which LLM to use: groq | gemini | ollama
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional backup, free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if you run Ollama locally
OLLAMA_BASE_URL=http://localhost:11434/v1

# Leave empty to use the provider defaults (see app/llm.py)
ANSWER_MODEL=
FAST_MODEL=

# How chunks get context before embedding: off | header | full
#   header = one LLM call per document (cheap, free-tier friendly)
#   full   = one LLM call per chunk (best quality, slow on free tiers)
CONTEXT_MODE=header
